# Local terraform working directory (provider binaries, cached modules). Never holds
# state here — the backend is gcs (see versions.tf) — but `init` still creates it.
.terraform/

# In case anyone ever runs this against a local/overridden backend by mistake.
*.tfstate
*.tfstate.*

# Override files that might carry real values (e.g. TF_VAR overrides for local testing).
*.tfvars

# Crash logs
crash.log
crash.*.log
